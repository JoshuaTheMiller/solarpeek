# ─────────────────────────────────────────────────────────────────────────────
# SolarPeak — Next.js Frontend Environment Variables
# Copy to frontend/.env.local and fill in values, or run: ruby scripts/auth0_setup.rb
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0 Next.js SDK (@auth0/nextjs-auth0) ───────────────────────────────────
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email

# ── Rails API ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Auth bypass (local dev / testing only) ────────────────────────────────────
# Mirror of the Rails bypass vars — must match what Rails is set to.
# Both must be set together. Neither alone has any effect.
# When active: Auth0 middleware is skipped, the proxy forwards requests
# without a token, and a bypass warning banner is shown in the UI.
#
# DISABLE_AUTH=true
# AM_I_SURE=yes
