# ─────────────────────────────────────────────────────────────────────────────
# SolarPeak — Rails Backend Environment Variables
# Copy to backend/.env and fill in values, or run: ruby scripts/auth0_setup.rb
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth0: JWT validation ─────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── Auth0: Management API (user invitation flow) ──────────────────────────────
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/solarpeak_development

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── First admin seed (optional — used by db:seed) ────────────────────────────
ADMIN_AUTH0_SUB=
ADMIN_EMAIL=

# ── Auth bypass (local dev / testing only) ────────────────────────────────────
# Both must be set together. Neither alone has any effect.
# When active: Auth0 is NOT required, all requests run as dev@localhost (admin).
# Categorically blocked in production.
#
# DISABLE_AUTH=true
# AM_I_SURE=yes
