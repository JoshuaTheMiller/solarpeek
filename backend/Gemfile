# frozen_string_literal: true

source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '3.2.0'

# ── Core ──────────────────────────────────────────────────────────────────────
gem 'rails',     '~> 7.1'
gem 'pg',        '~> 1.5'
gem 'puma',      '>= 6.0'
gem 'rack-cors', '~> 2.0'
gem 'dotenv-rails'

# ── Auth & Authorization ──────────────────────────────────────────────────────
gem 'jwt',    '~> 2.8'   # Auth0 JWT decoding
gem 'pundit', '~> 2.3'   # Policy-based authorization

# ── Caching ───────────────────────────────────────────────────────────────────
gem 'redis', '~> 5.0'

# ── HTTP Client (solar API + Auth0 Management API) ───────────────────────────
gem 'httparty', '~> 0.21'

# ── OpenAPI ───────────────────────────────────────────────────────────────────
gem 'rswag-api'  # Serves generated swagger.json at /openapi/v1/swagger.json
# rswag-ui intentionally omitted — Redocly is used instead (public/api-docs/index.html)

group :development, :test do
  gem 'rspec-rails',      '~> 6.1'
  gem 'rswag-specs'                    # DSL for writing OpenAPI specs
  gem 'factory_bot_rails', '~> 6.4'
  gem 'faker',             '~> 3.2'
  gem 'shoulda-matchers',  '~> 6.0'
  gem 'debug'
end

group :development do
  gem 'rubocop',       require: false
  gem 'rubocop-rails', require: false
end

group :test do
  gem 'webmock', '~> 3.23'  # Stub external HTTP calls in tests
end
